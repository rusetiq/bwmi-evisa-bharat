{
  "name": "india-evisa-redesign",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "db:migrate": "wrangler d1 migrations apply india-evisa --local",
    "db:migrate:remote": "wrangler d1 migrations apply india-evisa --remote",
    "db:seed": "wrangler d1 execute india-evisa --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute india-evisa --remote --file=./seed.sql"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@fontsource/fraunces": "latest",
    "@fontsource-variable/geist": "latest",
    "@hono/zod-validator": "latest",
    "@tailwindcss/vite": "latest",
    "hono": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "tailwindcss": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
