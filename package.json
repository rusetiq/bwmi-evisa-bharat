{
  "name": "india-evisa-redesign",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "db:migrate": "wrangler d1 migrations apply india-evisa --local",
    "db:migrate:remote": "wrangler d1 migrations apply india-evisa --remote",
    "db:seed": "wrangler d1 execute india-evisa --local --file=./seed.sql",
    "db:seed:remote": "wrangler d1 execute india-evisa --remote --file=./seed.sql"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@hono/zod-validator": "0.9.0",
    "@tailwindcss/vite": "4.3.3",
    "hono": "4.13.5",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "tailwindcss": "4.3.3",
    "web-vitals": "6.2.1",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260829.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
